{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++ Run",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "g++ -std=c++17 '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe'; if ($?) { Get-Content -Raw '${workspaceFolder}\\input.txt' | & '${fileDirname}\\${fileBasenameNoExtension}.exe' | Tee-Object -FilePath '${workspaceFolder}\\output.txt' }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}